# Unified Service Configuration (Version 2.0)
# Copy this file to .env and adjust values as needed

# ==================== Service Configuration ====================
PORT=5000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=unified-service-secret-key-change-in-production

# ==================== Qdrant Vector Database ====================
QDRANT_URL=http://localhost:6333

# ==================== Collections Configuration ====================
# RAG Collections (separate for RAG chatbot)
RAG_COLLECTION_HOTELS=hotels_rag
RAG_COLLECTION_COUPONS=coupons_rag

# Recommendation Collections (separate for recommendation system)
REC_COLLECTION_HOTELS=hotels_recommendation

# Legacy collection name (for backward compatibility)
COLLECTION_NAME=hotels

# ==================== Ollama Configuration ====================
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen3

# ==================== LLM Provider ====================
# Options: 'ollama' or 'lm_studio'
LLM_PROVIDER=ollama

# LM Studio URL (only if using LM Studio)
# LM_STUDIO_URL=http://192.168.10.42:1234

# ==================== Redis Cache ====================
REDIS_URL=redis://localhost:6380
REDIS_ENABLED=true

# ==================== MySQL Database ====================
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=myhotel

# ==================== RAG Configuration ====================
# Auto-index coupons on startup
AUTO_INDEX_COUPONS=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ==================== Recommendation Configuration ====================
REC_TOP_K=10
REC_USE_OLLAMA=true

# ==================== Performance Configuration ====================
EMBEDDING_CACHE_ENABLED=true
MAX_WORKERS=4

# ==================== Database Auto-Sync ====================
AUTO_SYNC_DATABASE=false

