# Unified Service Configuration (Version 2.0)
# Copy this file to .env and adjust values as needed

# ==================== Service Configuration ====================
PORT=5000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=unified-service-secret-key-change-in-production

# ==================== Qdrant Vector Database ====================
QDRANT_URL=http://localhost:6333

# ==================== Collections Configuration ====================
# RAG Collections (separate for RAG chatbot)
RAG_COLLECTION_HOTELS=hotels_rag
RAG_COLLECTION_COUPONS=coupons_rag

# Recommendation Collections (separate for recommendation system)
REC_COLLECTION_HOTELS=hotels_recommendation

# Legacy collection name (for backward compatibility)
COLLECTION_NAME=hotels

# ==================== Ollama Configuration ====================
# Ollama is used for embeddings (bge-m3)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ==================== LLM Provider ====================
# Options: 'ollama', 'lm_studio', or 'openrouter'
# Note: qwen3 uses LM Studio by default
LLM_PROVIDER=lm_studio
LLM_MODEL=qwen3

# LM Studio URL (for LLM generation)
# Default: http://localhost:1234
# In Docker: http://host.docker.internal:1234
LM_STUDIO_URL=http://localhost:1234

# OpenRouter Configuration (for cloud models like qwen/qwen2.5-vl-72b-instruct)
# Only needed when LLM_PROVIDER=openrouter
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api

# ==================== Redis Cache ====================
REDIS_URL=redis://localhost:6380
REDIS_ENABLED=true

# ==================== MySQL Database ====================
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=myhotel

# ==================== RAG Configuration ====================
# Auto-index coupons on startup
AUTO_INDEX_COUPONS=true
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ==================== Recommendation Configuration ====================
REC_TOP_K=10
REC_USE_OLLAMA=true

# ==================== Performance Configuration ====================
EMBEDDING_CACHE_ENABLED=true
MAX_WORKERS=4

# ==================== Database Auto-Sync ====================
AUTO_SYNC_DATABASE=false

